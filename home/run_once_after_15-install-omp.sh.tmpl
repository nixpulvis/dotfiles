{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
# Install or update omp (oh-my-pi) on Linux. It isn't packaged for pacman or apt,
# so download the pinned release binary into ~/.bin, which fish puts first on
# PATH. The version and checksums live in .chezmoidata/omp.yaml. `chezmoi` runs
# this once per machine, and again when the version or checksum changes.
set -eu

version="{{ .omp.version }}"
dest="$HOME/.bin/omp"

# Already at the pinned version? Nothing to do.
if [ -x "$dest" ] && "$dest" --version 2>/dev/null | grep -q "$version"; then
    exit 0
fi

# Pick the release asset and checksum for this CPU. These are the glibc builds.
# A musl distro would need the omp-linux-musl-* assets instead.
arch=$(uname -m)
case "$arch" in
    x86_64|amd64)  asset="omp-linux-x64";   sha="{{ index .omp.sha256 "linux-x64" }}" ;;
    aarch64|arm64) asset="omp-linux-arm64"; sha="{{ index .omp.sha256 "linux-arm64" }}" ;;
    *) echo "omp: unsupported architecture '$arch'; install manually from https://omp.sh" >&2; exit 1 ;;
esac

url="https://github.com/can1357/oh-my-pi/releases/download/v${version}/${asset}"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

echo "Installing omp ${version} (${asset})..." >&2
curl -fsSL "$url" -o "$tmp"

# Verify the checksum before trusting the binary.
if command -v sha256sum >/dev/null 2>&1; then
    echo "${sha}  ${tmp}" | sha256sum -c - >/dev/null
else
    echo "${sha}  ${tmp}" | shasum -a 256 -c - >/dev/null
fi

mkdir -p "$HOME/.bin"
install -m 0555 "$tmp" "$dest"
echo "omp ${version} installed to ${dest}" >&2
{{ end -}}
