{{- if ne .chezmoi.os "windows" -}}
{{-   $current := include ".chezmoi.toml.tmpl" | sha256sum -}}
{{-   $stored := "" -}}
{{-   if hasKey . "configTemplateHash" }}{{ $stored = .configTemplateHash }}{{ end -}}
{{-   if ne $stored $current -}}
#!/bin/sh
# A louder version of `chezmoi`'s easy-to-miss "config file template has
# changed" warning. The template guard above compares the config template's
# hash from the last `chezmoi init` (.configTemplateHash, missing counts as
# drift) with its current hash. If they match, this renders empty and is
# skipped. On drift it prints the banner, then aborts `chezmoi update`, since
# updating with stale config is wrong. (`chezmoi update --init` regenerates
# config first, so it never gets here.) For `apply` it only warns, so the
# edit/apply loop keeps working. Older `chezmoi` without CHEZMOI_COMMAND only
# gets the warning.
banner() { printf '%s\n' "$1" >&2; }
banner ""
banner "########################################################################"
banner "#  chezmoi: CONFIG FILE TEMPLATE HAS CHANGED -- your config is STALE.   #"
banner "#                                                                      #"
banner "#  Regenerate it (reuses your saved answers, won't re-prompt):         #"
banner "#                                                                      #"
banner "#      chezmoi update --init      # pull + regenerate config + apply    #"
banner "#      chezmoi init               # regenerate config only             #"
banner "#                                                                      #"
banner "#  Until then, dotfiles are applied from OUTDATED config values.       #"
banner "########################################################################"
banner ""
if [ "${CHEZMOI_COMMAND-}" = "update" ]; then
    banner "Refusing to update with a stale config. Run: chezmoi update --init"
    banner ""
    exit 1
fi
exit 0
{{-   end -}}
{{- end -}}
