{{/* Per-machine configuration. Answered once on `chezmoi init`, then persisted
     in this machine's chezmoi config file. Re-run `chezmoi init` to change. */}}

{{- $os := .chezmoi.os -}}
{{- $wsl := false -}}
{{- if eq $os "linux" -}}
{{-   if hasKey .chezmoi.kernel "osrelease" -}}
{{-     if or (contains "microsoft" (lower .chezmoi.kernel.osrelease)) (contains "wsl" (lower .chezmoi.kernel.osrelease)) -}}
{{-       $wsl = true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{/* Component groups.
     - base       : applied everywhere, never gated.
     - graphical  : GUI apps (alacritty + fonts). Implicit on macOS/Windows;
                    only a question on Linux, where a box may be headless (WSL,
                    servers).
     - wm         : the Linux window-manager stack (i3/sway/rofi/zathura). A
                    Linux-only option that implies `graphical`. macOS/Windows
                    have their own window managers, so it is always false there. */}}
{{- $graphical := true -}}
{{- $wm := false -}}
{{- if eq $os "linux" -}}
{{-   $graphical = promptBoolOnce . "graphical" "Graphical machine? (install alacritty + fonts)" (not $wsl) -}}
{{-   $wm = promptBoolOnce . "wm" "Install the Linux window-manager stack? (i3/sway/rofi/zathura)" false -}}
{{-   if $wm -}}{{- $graphical = true -}}{{- end -}}
{{- end -}}

{{- $name       := promptStringOnce . "name"       "Git user name"             "Nathan Lilienthal" -}}
{{- $email      := promptStringOnce . "email"      "Git email (personal/work)" "nathan@nixpulvis.com" -}}
{{- $signingkey := promptStringOnce . "signingkey" "Git signing key"           "Nathan Lilienthal" -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    signingkey = {{ $signingkey | quote }}
    wsl = {{ $wsl }}
    graphical = {{ $graphical }}
    wm = {{ $wm }}
