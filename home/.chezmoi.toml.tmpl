{{/* Per-machine configuration. Answered once on `chezmoi init`, then persisted
     in this machine's chezmoi config file. Re-run `chezmoi init` to change. */}}

{{- $os := .chezmoi.os -}}
{{- $wsl := false -}}
{{- if eq $os "linux" -}}
{{-   if hasKey .chezmoi.kernel "osrelease" -}}
{{-     if or (contains "microsoft" (lower .chezmoi.kernel.osrelease)) (contains "wsl" (lower .chezmoi.kernel.osrelease)) -}}
{{-       $wsl = true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{/* Feature questions. The answers are stored under [data.features.*], where
     they override the defaults in .chezmoidata/features.yaml. Every other
     feature is set by data alone. (This template can't read .chezmoidata, so
     defaults that depend on the machine are worked out here.)
     - graphical : GUI apps (alacritty, fonts, zed). Always on for macOS/Windows;
                   a question only on Linux, where a box may be headless (WSL,
                   servers).
     - wm        : the Linux window-manager stack (i3/sway/rofi/zathura). A
                   Linux-only question that implies `graphical`.
     - omp       : install omp and manage ~/.omp/agent.
     - weechat   : WeeChat with the ZNC bouncer login, its passphrase in the OS
                   keyring. Not on Windows. */}}
{{- $graphical := true -}}
{{- $wm := false -}}
{{- if eq $os "linux" -}}
{{-   $graphical = promptBoolOnce . "features.graphical.enabled" "Graphical machine? (alacritty, fonts, zed)" (not $wsl) -}}
{{-   $wm = promptBoolOnce . "features.wm.enabled" "Install the Linux window-manager stack? (i3/sway/rofi/zathura)" false -}}
{{-   if $wm -}}{{- $graphical = true -}}{{- end -}}
{{- end -}}
{{- $omp := promptBoolOnce . "features.omp.enabled" "Install omp and manage its config?" true -}}
{{- $weechat := false -}}
{{- if ne $os "windows" -}}
{{-   $weechat = promptBoolOnce . "features.weechat.enabled" "Set up WeeChat? (ZNC bouncer login; passphrase in the OS keyring)" (or (eq $os "darwin") $graphical) -}}
{{- end -}}

{{/* Not a feature: whether to install software at all (the enabled features'
     packages, omp and the Windows fonts), for machines that get it some other
     way. No means config only. */}}
{{- $installPackages := promptBoolOnce . "installPackages" "Install software? (packages, omp and font downloads; no means config only)" true -}}

{{- $name       := promptStringOnce . "name"       "Git user name"             "Nathan Lilienthal" -}}
{{- $email      := promptStringOnce . "email"      "Git email (personal/work)" "nathan@nixpulvis.com" -}}
{{- $signingkey := promptStringOnce . "signingkey" "Git signing key"           "Nathan Lilienthal" -}}
{{- $ircnick := "" -}}
{{- if $weechat -}}
{{-   $ircnick = promptStringOnce . "ircnick" "IRC nick / username" "nixpulvis" -}}
{{- end -}}

[data]
    # SHA256 of this config template at last `chezmoi init`. The drift-check
    # run_before script recomputes the current template's hash and compares:
    # a mismatch means the persisted config is stale (re-run `chezmoi init`).
    configTemplateHash = {{ include ".chezmoi.toml.tmpl" | sha256sum | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    signingkey = {{ $signingkey | quote }}
{{- if $weechat }}
    ircnick = {{ $ircnick | quote }}
{{- end }}
    wsl = {{ $wsl }}
    installPackages = {{ $installPackages }}
{{- if eq $os "linux" }}
[data.features.graphical]
    enabled = {{ $graphical }}
[data.features.wm]
    enabled = {{ $wm }}
{{- end }}
[data.features.omp]
    enabled = {{ $omp }}
{{- if ne $os "windows" }}
[data.features.weechat]
    enabled = {{ $weechat }}
{{- end }}

# Page `chezmoi diff` through delta, like git diff.
[diff]
{{- if eq $os "windows" }}
    # No sh outside Git Bash; winget installs delta with the base packages.
    pager = "delta"
{{- else }}
    # Fall back to less where delta isn't installed yet. chezmoi runs the pager
    # without a shell, hence sh -c.
    pager = "sh"
    pagerArgs = ["-c", "command -v delta >/dev/null && exec delta || exec less"]
{{- end }}
{{- if eq $os "windows" }}

# Run run_ scripts with -ExecutionPolicy Bypass so they work under Windows'
# default Restricted policy, without loosening the policy for anything else.
[interpreters.ps1]
    command = "powershell"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"]
{{- end }}
