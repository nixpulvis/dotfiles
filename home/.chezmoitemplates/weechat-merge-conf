# Merge logic shared by the WeeChat modify_ scripts. The caller sets two shell
# variables and then includes this file:
#   $managed: the "key = value" lines `chezmoi` owns (newline-separated)
#   $seed: the whole file to write on a fresh machine (empty stdin)
# Reads the current file from stdin, replaces each managed line wherever it
# appears (matched on the key before the first space), and passes every other
# line through. If stdin is empty, prints $seed instead.
MANAGED="$managed" SEED="$seed" awk '
    BEGIN {
        n = split(ENVIRON["MANAGED"], line, "\n")
        for (i = 1; i <= n; i++) {
            if (line[i] == "") continue
            key = line[i]; sub(/ .*/, "", key)
            want[key] = line[i]
        }
    }
    { seen = 1; if ($1 in want) print want[$1]; else print $0 }
    END { if (!seen) printf "%s\n", ENVIRON["SEED"] }
'
