{{- /* Component gating. `base` (everything not listed here) applies everywhere.
       Groups are chosen per-machine by `chezmoi init` (see .chezmoi.toml.tmpl):
       `graphical` (GUI apps) and `wm` (the Linux window-manager stack). */ -}}

{{- if not .graphical }}
.config/alacritty
.config/zed
AppData/Roaming/alacritty
{{- end }}

{{- /* The window-manager stack only makes sense on a graphical Linux box. */ -}}
{{- if or (ne .chezmoi.os "linux") (not .wm) }}
.config/i3
.config/i3blocks
.config/sway
.config/rofi
.config/zathura
.config/user-dirs.dirs
.xinitrc
.X
{{- end }}

{{- /* Linux-only helper. */ -}}
{{- if ne .chezmoi.os "linux" }}
.bin/share-network
{{- end }}

{{- /* Alacritty's colors.toml links to nixpulvis-dark.toml or -light.toml. On
       macOS the alacritty-color-mode login agent owns the link and flips it
       with the system appearance, so chezmoi leaves it alone there. Elsewhere
       chezmoi makes it a fixed link to the dark palette. */ -}}
{{- if eq .chezmoi.os "darwin" }}
.config/alacritty/colors.toml
{{- else }}
.config/alacritty/alacritty-color-mode.swift
Library
{{- end }}

{{- /* ~/.bin/fd and ~/.bin/bat link to Debian/Ubuntu's renamed `fdfind` and
       `batcat`. Same apt check as run_once_after_10-install-packages, so they
       exist exactly where apt installed those packages. */ -}}
{{- if or (ne .chezmoi.os "linux") (lookPath "pacman") (not (lookPath "apt-get")) }}
.bin/fd
.bin/bat
{{- end }}

{{- /* Windows-only config-path symlinks (%LOCALAPPDATA%, %APPDATA%). */ -}}
{{- if ne .chezmoi.os "windows" }}
AppData
{{ end -}}

{{- /* No WeeChat on Windows, and irc.conf is applied by a POSIX modify_
       script, so skip the whole config there. */ -}}
{{- if eq .chezmoi.os "windows" }}
.config/weechat
{{- end }}

{{/* omp: track only agent/config.yml, agent/AGENTS.md, agent/themes/ and agent/extensions/.
     Everything else under agent/ is ignored so auth tokens, sessions, caches
     and *.db files never get added, including ones that don't exist yet.
     No left trim here: it would glue this block onto the WeeChat line above. */ -}}
.omp/agent/*
!.omp/agent/config.yml
!.omp/agent/AGENTS.md
!.omp/agent/themes
!.omp/agent/extensions
