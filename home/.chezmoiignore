{{- /* Feature gating: the `targets` of every feature that's off on this machine
       (.chezmoidata/features.yaml, resolved by .chezmoitemplates/features).
       What's left below are per-OS details within features. */ -}}
{{- $f := includeTemplate "features" . | fromJson -}}
{{- range $n, $on := $f }}{{ if not $on }}{{ range (default (list) (get (index $.features $n) "targets")) }}
{{ . }}
{{- end }}{{ end }}{{ end }}

{{- /* The ssh-agent systemd user service is Linux only. */ -}}
{{- if ne .chezmoi.os "linux" }}
.config/systemd
{{- end }}

{{- /* Alacritty's colors.toml links to nixpulvis-dark.toml or -light.toml. On
       macOS the alacritty-color-mode login agent owns the link and flips it
       with the system appearance, so chezmoi leaves it alone there. Elsewhere
       chezmoi makes it a fixed link to the dark palette. */ -}}
{{- if eq .chezmoi.os "darwin" }}
.config/alacritty/colors.toml
{{- else }}
.config/alacritty/alacritty-color-mode.swift
Library
{{- end }}

{{- /* ~/.bin/fd and ~/.bin/bat link to Debian/Ubuntu's renamed `fdfind` and
       `batcat`. Same apt check as run_once_after_10-install-packages, so they
       exist exactly where apt installs those packages. */ -}}
{{- if or (ne .chezmoi.os "linux") (lookPath "pacman") (not (lookPath "apt-get")) }}
.bin/fd
.bin/bat
{{- end }}

{{- /* Windows-only config-path symlinks (%LOCALAPPDATA%, %APPDATA%). */ -}}
{{- if ne .chezmoi.os "windows" }}
AppData
{{- end }}

{{- /* omp: track only agent/config.yml, agent/AGENTS.md, agent/themes/ and
       agent/extensions/. Everything else under agent/ is ignored so auth
       tokens, sessions, caches and *.db files never get added, including ones
       that don't exist yet. With the omp feature off, its `.omp` target above
       wins over these ! exclusions. */}}
.omp/agent/*
!.omp/agent/config.yml
!.omp/agent/AGENTS.md
!.omp/agent/themes
!.omp/agent/extensions
{{- includeTemplate "overlay-hook" (dict "path" ".chezmoiignore" "data" .) }}
