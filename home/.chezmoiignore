{{- /* Component gating. `base` (everything not listed here) applies everywhere.
       Groups are chosen per-machine by `chezmoi init` (see .chezmoi.toml.tmpl):
       `graphical` (GUI apps) and `wm` (the Linux window-manager stack). */ -}}

{{- if not .graphical }}
.config/alacritty
AppData/Roaming/alacritty
{{- end }}

{{- /* The window-manager stack only makes sense on a graphical Linux box. */ -}}
{{- if or (ne .chezmoi.os "linux") (not .wm) }}
.config/i3
.config/i3blocks
.config/sway
.config/rofi
.config/zathura
.config/user-dirs.dirs
.xinitrc
.X
{{- end }}

{{- /* Linux-only helper. */ -}}
{{- if ne .chezmoi.os "linux" }}
.bin/share-network
{{- end }}

{{- /* Windows-only config-path symlinks (%LOCALAPPDATA%, %APPDATA%). */ -}}
{{- if ne .chezmoi.os "windows" }}
AppData
{{ end -}}

{{- /* OMP coding agent: track ONLY agent/config.yml and agent/themes/.
       Ignore everything else under agent/ (fails closed) so volatile state and
       secrets -- auth tokens, sessions, caches, *.db -- can never be swept in,
       even ones that don't exist yet. */ -}}
.omp/agent/*
!.omp/agent/config.yml
!.omp/agent/themes
