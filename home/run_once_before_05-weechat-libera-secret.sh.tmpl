{{- if and .libera (ne .chezmoi.os "windows") -}}
#!/bin/sh
# Seed the Libera.Chat SASL password into the OS keychain so chezmoi can render
# it into ~/.config/weechat/irc.conf via the `keyring` template function. Runs
# before files are applied (so irc.conf resolves) and once per machine. The
# password is never written to this repo or to chezmoi's config.
set -eu

service=libera
account={{ .ircnick | quote }}

read_secret() {
    # Password -> stdout, prompt -> stderr. Hidden prompt when attached to a
    # terminal; empty otherwise, so a non-interactive apply never blocks.
    _pw=''
    if [ -t 0 ]; then
        printf 'Libera.Chat password for %s (stored in the OS keychain, not the repo): ' "$account" >&2
        stty -echo 2>/dev/null || true
        IFS= read -r _pw || true
        stty echo 2>/dev/null || true
        printf '\n' >&2
    fi
    printf '%s' "$_pw"
}
{{ if eq .chezmoi.os "darwin" }}
# macOS Keychain (chezmoi keyring maps: -s service, -a account).
if security find-generic-password -s "$service" -a "$account" >/dev/null 2>&1; then
    exit 0
fi
pw=$(read_secret)
security add-generic-password -U -s "$service" -a "$account" -w "$pw"
if [ -z "$pw" ]; then
    echo "NOTE: stored an EMPTY Libera password. Set it later, then \`chezmoi apply\`:" >&2
    echo "        security add-generic-password -U -s $service -a $account -w" >&2
fi
{{- else }}
# Linux/Unix Secret Service (chezmoi keyring attributes: service, username).
if ! command -v secret-tool >/dev/null 2>&1; then
    echo "ERROR: secret-tool (libsecret) not found but WeeChat/Libera login is enabled." >&2
    echo "       Install libsecret + a running keyring daemon, then: chezmoi apply" >&2
    echo "       (or re-run \`chezmoi init\` and answer no to the Libera prompt)." >&2
    exit 1
fi
if secret-tool lookup service "$service" username "$account" >/dev/null 2>&1; then
    exit 0
fi
pw=$(read_secret)
printf '%s' "$pw" | secret-tool store --label="WeeChat Libera ($account)" service "$service" username "$account"
if [ -z "$pw" ]; then
    echo "NOTE: stored an EMPTY Libera password. Set it later, then \`chezmoi apply\`:" >&2
    echo "        printf %s '<password>' | secret-tool store --label=WeeChat service $service username $account" >&2
fi
{{- end }}
{{- end -}}
