[user]
    name = {{ .name }}
    email = {{ .email }}
    signingkey = {{ .signingkey }}

[alias]
    up = !git remote update -p
    a = add
    b = branch
    c = clone
    d = diff
    f = fetch
    sh = show
    i = commit
    l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    m = merge
    in = init
    o = remote
    p0 = rev-list --max-parents=0 HEAD
    p = push
    r = rebase
    s = status -s
    t = tag
    u = reset
    pl = pull
    w = whatchanged
    x = checkout
    z = stash
    cp = cherry-pick

[core]
    excludesFile = ~/.gitignore
    # delta pages diffs with syntax highlighting. Fall back to plain less (and
    # an unfiltered `add -p`) where it isn't installed yet, e.g. before the
    # package script has run. git runs both through sh, also on Windows.
    pager = command -v delta >/dev/null && exec delta || exec less

[interactive]
    diffFilter = command -v delta >/dev/null && exec delta --color-only || exec cat

[delta]
    # n/N jump between files in a diff. Light/dark is detected from the
    # terminal.
    navigate = true

[init]
    defaultBranch = master

[branch]
    autosetuprebase = always
    # `git branch` lists the most recently committed-to branches first.
    sort = -committerdate

[commit]
    # Show the diff below the message in the commit editor.
    verbose = true

[rerere]
    # Record conflict resolutions and replay them when the same conflict comes
    # back, e.g. rebasing the same branch again.
    enabled = true

[rebase]
    # `git commit --fixup=<commit>` commits fold into their target on the next
    # `git rebase -i`.
    autoSquash = true
    # Rebasing a branch also moves branches stacked on top of it.
    updateRefs = true

[push]
    # The first push of a new branch sets its upstream; no `-u` needed.
    autoSetupRemote = true

[fetch]
    # Drop remote-tracking branches that were deleted on the remote.
    prune = true

[apply]
    whitespace = warn

[credential]
{{- if eq .chezmoi.os "darwin" }}
    helper = osxkeychain
{{- else if eq .chezmoi.os "windows" }}
    helper = manager
{{- else }}
    {{- /* Linux/WSL: in-memory cache, nothing on disk, no extra deps. Could
           switch to `libsecret` (GNOME Keyring) or GCM where a Secret Service
           exists, or to `pass-git-helper` (helper = /usr/bin/pass-git-helper)
           to use the `pass` store, which needs the pass-git-helper package
           (AUR / pip). */}}
    helper = cache --timeout=86400
{{- end }}

[diff]
    tool = nvimdiff
    # Usually more readable hunks than the default myers, e.g. around moved
    # or repeated lines.
    algorithm = histogram
[merge]
    tool = nvimdiff
    # Conflict markers also show the common ancestor's version.
    conflictStyle = zdiff3
[pull]
    ff = only
# Keeps branch.<name>.base and friends current for wt list-base's Base and
# Base…± columns; see ~/.config/worktrunk/record-base.
[hook "wt-base"]
    event = reference-transaction
    command = "s=$HOME/.config/worktrunk/record-base; [ \"$1\" = committed ] && [ -x \"$s\" ] && while read -r _ _ r; do case $r in refs/heads/*) exec \"$s\" \"$1\";; esac; done; :"
