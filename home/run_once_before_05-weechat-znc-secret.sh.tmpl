{{- if and .libera (ne .chezmoi.os "windows") -}}
#!/bin/sh
# Seed the ZNC bouncer password into the OS keyring so chezmoi can render it into
# ~/.config/weechat/irc.conf via the `keyring` template function. Runs once per
# machine, before files are applied (so irc.conf resolves on the same run). This
# is the password WeeChat uses to log in to your ZNC bouncer; ZNC in turn holds
# the Libera account credentials server-side.
#
# Uses `chezmoi secret keyring`, which reads/writes the SAME go-keyring store the
# template reads (macOS login keychain, Linux Secret Service, Windows Credential
# Manager) -- cross-platform, and the write always matches the read. `set` with
# no --value prompts for the password on the terminal (/dev/tty) with input
# hidden, so the secret never touches shell history, argv, or this repo.
set -eu

service=znc
account={{ .ircnick | quote }}

# Already seeded with a non-empty value? Nothing to do. (An error or empty result
# falls through and re-prompts, so a previously stored EMPTY value is corrected.)
if v=$(chezmoi secret keyring get --service "$service" --user "$account" 2>/dev/null) \
   && [ -n "$v" ]; then
    exit 0
fi

# chezmoi reads the value straight from /dev/tty; when there is no controlling
# terminal (non-interactive apply) the command fails and we fall through to the
# note instead of blocking. Note: chezmoi does NOT wire script stdin to a TTY,
# so a shell `read` here would never prompt -- letting chezmoi open /dev/tty is
# what makes the interactive prompt work during `chezmoi init --apply`.
if chezmoi secret keyring set --service "$service" --user "$account" 2>/dev/null; then
    v=$(chezmoi secret keyring get --service "$service" --user "$account" 2>/dev/null || true)
    [ -n "$v" ] && exit 0
fi

echo "NOTE: no ZNC bouncer password stored yet. Set it (prompts on the terminal," >&2
echo "      input hidden, nothing saved to shell history), then run \`chezmoi apply\`:" >&2
echo "        chezmoi secret keyring set --service $service --user $account" >&2
{{- end -}}
