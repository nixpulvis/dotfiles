# Interactive setup for bash and zsh, sourced by ~/.bashrc and ~/.zshrc after
# env.sh. Variables and aliases are shared with fish: edit them in
# .chezmoidata/shell.yaml. This file holds what needs sh code: tool hooks, the
# ** completion lists and the git prompt helpers each shell's rc builds its
# prompt from.

{{ includeTemplate "shell-shared" (dict "shell" "sh" "part" "interactive" "s" .shell) }}
if [[ -n ${ZSH_VERSION-} ]]; then __sh=zsh; else __sh=bash; fi

# fzf key bindings: ctrl-r history, ctrl-t file paths, alt-c cd. Its settings
# are in shell.yaml. `fzf --bash`/`--zsh` needs fzf 0.48+, so older versions
# are skipped instead of failing. It also adds fuzzy completion: type ** then
# Tab (vim **, cd src/**, kill **, ssh **). bash 3.2 (macOS) can't hook every
# command, so there ** works only after fzf's list of common ones (cat, vim,
# git, ls, cd, ...; not echo).
if command -v fzf >/dev/null 2>&1; then
	if __fzf_init=$(fzf --$__sh 2>/dev/null); then
		eval "$__fzf_init"
	fi
	unset __fzf_init
	if command -v fd >/dev/null 2>&1; then
		# ** completion lists. $1 is the directory typed before the **.
		_fzf_compgen_path() { fd --hidden --exclude .git . "$1"; }
		_fzf_compgen_dir() { fd --type d --hidden --exclude .git . "$1"; }
	fi
fi

if command -v rbenv >/dev/null 2>&1; then
	eval "$(rbenv init - $__sh)"
fi

# Worktrunk's wt wrapper, so `wt switch` can cd this shell into the worktree.
# See config.fish.
if command -v wt >/dev/null 2>&1; then
	eval "$(wt config shell init $__sh)"
fi
unset __sh
{{ if eq .chezmoi.os "windows" }}
# Git Bash has no session agent. The first shell starts one and records it in
# ~/.ssh/agent.env; later shells reuse it while it still answers, so there's one
# agent per Windows login, not one per shell (GitHub's "Auto-launching
# ssh-agent on Git for Windows"). Elsewhere SSH_AUTH_SOCK comes from launchd
# (macOS) or the ssh-agent systemd user service (Linux).
if command -v ssh-agent >/dev/null 2>&1 && [[ -z ${SSH_AUTH_SOCK-} ]]; then
	__agent_env=~/.ssh/agent.env
	[[ -f $__agent_env ]] && . "$__agent_env" >/dev/null
	# ssh-add exits 2 when it can't reach an agent.
	ssh-add -l >/dev/null 2>&1
	if [[ $? -eq 2 ]]; then
		mkdir -p ~/.ssh
		(umask 077; ssh-agent -s >"$__agent_env")
		. "$__agent_env" >/dev/null
	fi
	unset __agent_env
fi
{{ end }}
# Load __git_ps1. Its location varies by platform.
if ! type __git_ps1 >/dev/null 2>&1; then
	if [[ ${OSTYPE-} == msys ]]; then
		# Git Bash: git-prompt.sh ships alongside git's own install. Git for
		# Windows' /etc/profile.d/git-prompt.sh normally loads it with its
		# default prompt; since we replace that prompt, load it ourselves.
		__git_completion="$(git --exec-path 2>/dev/null)"
		__git_completion="${__git_completion%/libexec/git-core}"
		__git_completion="${__git_completion%/lib/git-core}"
		__git_completion="$__git_completion/share/git/completion"
		[[ -f $__git_completion/git-completion.bash ]] && . "$__git_completion/git-completion.bash" 2>/dev/null
		[[ -f $__git_completion/git-prompt.sh ]] && . "$__git_completion/git-prompt.sh"
		unset __git_completion
	else
		for __f in \
			/usr/share/git/completion/git-prompt.sh \
			/usr/lib/git-core/git-sh-prompt \
			/usr/share/git-core/contrib/completion/git-prompt.sh \
			/opt/homebrew/etc/bash_completion.d/git-prompt.sh \
			/usr/local/etc/bash_completion.d/git-prompt.sh \
			/Library/Developer/CommandLineTools/usr/share/git-core/git-prompt.sh
		do
			[[ -f $__f ]] && { . "$__f"; break; }
		done
		unset __f
	fi
fi

# No git-prompt.sh found: fall back to a prompt without the git segment.
if ! type __git_ps1 >/dev/null 2>&1; then
	__git_ps1() { PS1="$1$2"; }
fi

# Match the fish dotfiles git settings.
GIT_PS1_SHOWDIRTYSTATE=1
GIT_PS1_SHOWSTASHSTATE=1
GIT_PS1_SHOWUNTRACKEDFILES=1
GIT_PS1_SHOWCOLORHINTS=1

# fish prompt_pwd: shorten every path component except the last to one char.
# The ~ comes from a variable because a literal one in the replacement keeps
# its backslash or gets expanded, depending on the shell and version.
__prompt_pwd() {
	local tilde='~'
	local p="${PWD/#$HOME/$tilde}"
	printf '%s' "$p" | sed -e 's|\([^/]\)[^/]*/|\1/|g'
}
