# Environment for bash and zsh. PATH and variables are shared with fish: edit
# them in .chezmoidata/shell.yaml. This file holds what needs sh code.
#
# Sourced by ~/.bash_profile, ~/.bashrc and ~/.zshrc, so it runs more than once
# per shell and again in nested shells. Everything here must be idempotent.

# Homebrew sets MANPATH, HOMEBREW_PREFIX (used by .zshrc's completion) and
# friends. Skip it once it's been run, e.g. in a nested shell. Its bin dirs are
# also in shell.yaml's path, so they keep their place even after path_helper
# reorders PATH in a zsh login shell.
if [[ -z ${HOMEBREW_PREFIX-} ]]; then
	if [[ -x /opt/homebrew/bin/brew ]]; then
		eval "$(/opt/homebrew/bin/brew shellenv)"
	elif [[ -x /usr/local/bin/brew ]]; then
		eval "$(/usr/local/bin/brew shellenv)"
	fi
fi

{{ includeTemplate "shell-shared" (dict "shell" "sh" "part" "env" "s" .shell) }}
