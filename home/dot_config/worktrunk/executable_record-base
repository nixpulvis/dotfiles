#!/bin/sh
# Record each branch's base for the Base↕ and Base…± columns in wt list: the
# nearest branch it sits on top of, or the default branch if none. A local
# branch's candidates are the local branches. A remote branch's (origin/foo)
# are the local and remote branches, less the local branches tracking it, and
# its default is the remote's copy of the default branch (origin/main) when
# there is one. Branches already contained in the default branch (merged, or
# never moved past it) don't count as bases, and orphan branches (no history
# shared with the default branch) get none. A recorded base that gained commits
# since the branch forked from it stays its base. Writes branch.<name>.base,
# .baseahead and .basebehind (commits ahead/behind the base), and .baseadded
# and .basedeleted (lines changed since the fork point), skipping unchanged
# values; <name> is origin/foo for a remote branch, which is where wt list
# --remotes reads that row's git.branch.* from. Keys of branches that no longer
# exist (a pruned remote branch) are removed.
#
# Installed as a global git reference-transaction hook (hook.wt-base in
# ~/.gitconfig), so any commit, rebase, reset, branch create/delete/rename, or
# fetch refreshes it, in repos wt manages (those with a .git/wt directory).
#
# A failing reference-transaction hook aborts the ref update, and git runs the
# hook six times per update. So the hook.wt-base.command one-liner filters
# with shell builtins, exiting 0 unless the phase is committed, a refs/heads/
# or refs/remotes/ ref changed, and this script exists; only then does it exec
# this script with the phase as an argument. With an argument, the script
# checks for .git/wt and hands the work to a detached run git doesn't wait on.
# With no arguments it refreshes the current repo in the foreground.

set -uf

if [ $# -gt 0 ]; then
  common=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
  [ -d "$common/wt" ] || exit 0
  "$0" </dev/null >/dev/null 2>&1 &
  exit 0
fi

set_config() {
  [ "$(git config --get "$1")" = "$2" ] || git config "$1" "$2"
}

# Refnames under the given prefixes, skipping symrefs like origin/HEAD.
refs() {
  git for-each-ref --format='%(if)%(symref)%(then)%(else)%(refname)%(end)' "$@"
}

# record <branch> <default> <prefix>...: record the base of branch (a full
# refname) against default, choosing among branches under the given prefixes.
# Reads $tracking from update.
record() {
  b=$1
  d=$2
  shift 2
  name=${b#refs/heads/}
  name=${name#refs/remotes/}
  if ! git merge-base "$d" "$b" >/dev/null; then
    # Orphan: no history shared with the default branch, so no base.
    for k in base baseahead basebehind baseadded basedeleted; do
      git config --unset-all "branch.$name.$k"
    done
    return
  fi
  in_default=" $(refs --merged="$d" "$@" | tr '\n' ' ') "
  base=$d
  best=
  # Strict ancestors of b: merged into it, but not at or past its tip.
  for c in $(refs --merged="$b" --no-contains="$b" "$@"); do
    if [ "$c" != "$d" ]; then
      case $in_default in *" $c "*) continue ;; esac
    fi
    # A local branch tracking b trails it rather than being its base.
    case $tracking in *" $c>$b "*) continue ;; esac
    n=$(git rev-list --count "$c..$b")
    # On a tie (f1 at the same commit as origin/f1) a remote branch keeps the
    # remote base; candidates come sorted with refs/heads/ first.
    if [ -z "$best" ] || [ "$n" -lt "$best" ] || {
      [ "$n" = "$best" ] && [ "${c#refs/remotes/}" != "$c" ] && [ "${base#refs/heads/}" != "$base" ]
    }; then
      best=$n
      base=$c
    fi
  done
  # Keep the recorded base r when it moved on (new commits b hasn't been
  # rebased onto): b still forks from r at a commit the default branch lacks,
  # at or above the nearest ancestor found. Rebasing b elsewhere, or r being
  # merged or rewritten, moves that fork point and drops r. A local r at the
  # same commit as a remote base is the tie above, which the remote base wins.
  r=$(git config --get "branch.$name.base")
  rref=
  if [ -n "$r" ]; then
    for p in "$@"; do
      if git show-ref -q --verify "$p$r"; then
        rref=$p$r
        break
      fi
    done
  fi
  if [ -n "$rref" ] && [ "$rref" != "$base" ] &&
    ! { [ "${rref#refs/heads/}" != "$rref" ] && [ "${base#refs/remotes/}" != "$base" ] &&
      [ "$(git rev-parse "$rref")" = "$(git rev-parse "$base")" ]; } &&
    ! git merge-base --is-ancestor "$b" "$rref" &&
    fork=$(git merge-base "$rref" "$b") &&
    ! git merge-base --is-ancestor "$fork" "$d" &&
    git merge-base --is-ancestor "$base" "$fork"; then
    base=$rref
  fi
  short=${base#refs/heads/}
  set_config "branch.$name.base" "${short#refs/remotes/}"
  set_config "branch.$name.baseahead" "$(git rev-list --count "$base..$b")"
  set_config "branch.$name.basebehind" "$(git rev-list --count "$b..$base")"
  # Lines changed since the fork point, counted like main…±: renames detected
  # (-M), via plumbing so diff config doesn't change the counts.
  lines=$(git diff-tree -r -M --numstat "$(git merge-base "$base" "$b")" "$b" |
    awk '{ added += $1; deleted += $2 } END { print added + 0, deleted + 0 }')
  set_config "branch.$name.baseadded" "${lines% *}"
  set_config "branch.$name.basedeleted" "${lines#* }"
}

update() {
  def=$(wt config state default-branch get 2>/dev/null) && [ -n "$def" ] || return 0
  # "<local branch>><its upstream>" pairs, so record can skip a branch's
  # local copies.
  tracking=" $(git for-each-ref --format='%(refname)>%(upstream)' refs/heads/ | tr '\n' ' ') "
  for x in $(refs refs/heads/); do
    [ "$x" != "refs/heads/$def" ] || continue
    record "$x" "refs/heads/$def" refs/heads/
  done
  for remote in $(git remote); do
    rdef=refs/remotes/$remote/$def
    git show-ref -q --verify "$rdef" || rdef=refs/heads/$def
    for x in $(refs "refs/remotes/$remote/"); do
      [ "$x" != "$rdef" ] || continue
      record "$x" "$rdef" refs/heads/ refs/remotes/
    done
  done
  # Drop the keys of branches that are gone. Deleting a local branch deletes
  # its section, but pruning a remote branch leaves branch.origin/foo behind;
  # its section goes too once nothing else is in it.
  for x in $(git config --local --name-only --get-regexp '^branch\..*\.base$' | sed 's/^branch\.//; s/\.base$//'); do
    if git show-ref -q --verify "refs/heads/$x" || git show-ref -q --verify "refs/remotes/$x"; then
      continue
    fi
    for k in base baseahead basebehind baseadded basedeleted; do
      git config --unset-all "branch.$x.$k"
    done
    git config --local --name-only --list | awk -v p="branch.$x." 'index($0, p) == 1 { f = 1 } END { exit f }' &&
      git config --remove-section "branch.$x"
  done
}

# Ref updates can land while a run is in flight (a stack rebase moves several
# branches), so runs serialize on a lock dir and the holder repeats while
# another update is pending. A lock left by a killed run expires after 5 min.
common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1
lock=$common/wt-base.lock
pending=$common/wt-base.pending
: >"$pending"
find "$lock" -maxdepth 0 -mmin +5 -exec rmdir {} + 2>/dev/null
while [ -e "$pending" ] && mkdir "$lock" 2>/dev/null; do
  trap 'rmdir "$lock"' EXIT
  trap 'exit 1' HUP INT TERM
  while [ -e "$pending" ]; do
    rm -f "$pending"
    update
  done
  rmdir "$lock"
  trap - EXIT HUP INT TERM
done
