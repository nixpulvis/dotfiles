#
# weechat -- irc.conf
#
# Libera.Chat server, managed by chezmoi. Only the server definition is seeded
# here; every other IRC option is filled with WeeChat defaults on first load
# (WeeChat rewrites this file on /save, so re-run `chezmoi add` after tuning).
#
# The SASL password is NOT stored in this repo. chezmoi reads it from the OS
# keychain (service "libera", account "{{ .ircnick }}") at apply time via the `keyring`
# template function; run_once_before_05-weechat-libera-secret seeds it on init.
# To change it later: re-store in the keychain, then `chezmoi apply`.
#

[server_default]

[server]
libera.addresses = "irc.libera.chat/6697"
libera.tls = on
libera.tls_verify = on
libera.nicks = "{{ .ircnick }}"
libera.username = "{{ .ircnick }}"
libera.realname = "{{ .name }}"
{{- if .libera }}
libera.sasl_mechanism = plain
libera.sasl_username = "{{ .ircnick }}"
libera.sasl_password = "{{ keyring "libera" .ircnick }}"
libera.autoconnect = on
libera.autojoin = "#alacritty,#rust"
{{- else }}
libera.autoconnect = off
{{- end }}
