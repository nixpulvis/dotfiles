#
# weechat -- irc.conf
#
# Seeded ONCE by chezmoi (create_ prefix): written only if
# ~/.config/weechat/irc.conf does not already exist. WeeChat then owns the file
# -- it fills in defaults and rewrites on /save, and chezmoi never overwrites it.
# To re-seed from scratch, delete irc.conf and `chezmoi apply`.
#
# Connects to your ZNC bouncer, NOT to Libera directly: ZNC holds the Libera
# account credentials server-side, stays connected, and replays history. The
# only secret here is the ZNC login password, read from the OS keyring (service
# "znc", account "{{ .ircnick }}") via the `keyring` function -- never in this repo.
# The self-signed ZNC cert is pinned by SHA-256 fingerprint (znc.tls_fingerprint).
# To change the ZNC password once seeded: set it in WeeChat
# (/set irc.server.znc.password "{{ .ircnick }}/libera:...") or re-store in the
# keyring and re-seed (delete irc.conf, then `chezmoi apply`).
#

[server_default]

[server]
znc.addresses = "ref8.net/6697"
znc.tls = on
znc.tls_verify = off
znc.tls_fingerprint = "85a9e90cfd85fc7fc5ded00ef660100cbf08c18050d2979959c86d26c7722184"
znc.nicks = "{{ .ircnick }}"
znc.username = "{{ .ircnick }}"
znc.realname = "{{ .name }}"
{{- if .libera }}
znc.password = "{{ .ircnick }}/libera:{{ keyring "znc" .ircnick }}"
znc.autoconnect = on
{{- else }}
znc.autoconnect = off
{{- end }}
