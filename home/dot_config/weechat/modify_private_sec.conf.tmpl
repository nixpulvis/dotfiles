{{- /* modify_ script: sets sec.crypt.passphrase_command so WeeChat gets its
       secured-data passphrase from the OS keyring (stored by run_once_before_05)
       and doesn't prompt on launch. The rest of sec.conf (crypt defaults and the
       encrypted [data] from /secure set) belongs to WeeChat and passes through.
       On a fresh machine stdin is empty and $seed gets written. The `chezmoi` path
       is absolute so it works whatever WeeChat's PATH is. Merge logic is in
       .chezmoitemplates/weechat-merge-conf. */ -}}
{{- if and .libera (ne .chezmoi.os "windows") -}}
#!/bin/sh
set -eu

# The one line `chezmoi` owns. WeeChat owns the rest (crypt defaults, [data]).
managed=$(cat <<'EOF'
passphrase_command = "{{ .chezmoi.executable }} secret keyring get --service weechat --user {{ .ircnick }}"
EOF
)
seed=$(cat <<EOF
[crypt]
$managed

[data]
EOF
)
{{ includeTemplate "weechat-merge-conf" . -}}
{{- end -}}
