{{- /* modify_ script: `chezmoi` passes the current irc.conf on stdin and stdout
       replaces it. WeeChat owns the file. Only the znc.* lines below (the ZNC
       connection and the channels from .chezmoidata/weechat.yaml) are
       rewritten, everything else passes through. On a fresh machine stdin is
       empty and $seed gets written. The password is ${sec.data.znc}, decrypted
       from WeeChat secured data (see modify_private_sec.conf.tmpl). ZNC keeps
       you in channels you /join yourself until you /part them. Merge logic is
       in .chezmoitemplates/weechat-merge-conf. */ -}}
{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
set -eu

# Lines `chezmoi` owns. Each key is unique to [server].
managed=$(cat <<'EOF'
znc.addresses = "ref8.net/6697"
znc.tls = on
znc.tls_verify = off
znc.tls_fingerprint = "85a9e90cfd85fc7fc5ded00ef660100cbf08c18050d2979959c86d26c7722184"
znc.nicks = "{{ .ircnick }}"
znc.username = "{{ .ircnick }}"
znc.realname = "{{ .name }}"
{{- if .libera }}
znc.password = "{{ .ircnick }}/libera:${sec.data.znc}"
znc.autoconnect = on
znc.autojoin = "{{ .weechat.autojoin | join "," }}"
{{- else }}
znc.autoconnect = off
{{- end }}
EOF
)
seed=$(cat <<EOF
[server_default]

[server]
$managed
EOF
)
{{ includeTemplate "weechat-merge-conf" . -}}
{{- end -}}
