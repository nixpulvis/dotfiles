-- Neovim config, in modules under lua/config/:
--
--   plugins     vim-plug, the plugin list and plugin settings
--   options     editor options and the color scheme
--   keymaps     general keys
--   quickfix    keys in quickfix and location lists
--   completion  completion menus (nvim-cmp)
--   lsp/        language servers: navigation (pickers and symbol uses), inlay
--               hints and progress
--   statusline  the status line (lightline)
--
-- Language server configs are in lsp/ and after/lsp/, and cheatsheet.md lists
-- the keys.

-- First: it puts the plugins on 'runtimepath' for the rest.
require('config.plugins')

require('config.options')
require('config.keymaps')
require('config.quickfix')
require('config.completion')
require('config.lsp')
require('config.statusline')
