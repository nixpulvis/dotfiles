{{ $f := includeTemplate "features" . | fromJson -}}
[user]
name = {{ .name | quote }}
email = {{ .email | quote }}

[ui]
# Set explicitly so bare `jj` stops printing the hint about this setting.
default-command = "log"
{{- if $f.delta }}
# Delta only understands git-style diffs, so switch jj off its default color-words format.
pager = "delta"
diff-formatter = ":git"
{{- end }}

[snapshot]
# Track no new file until `jj file track <path>` adds it. By default anything
# .gitignore misses goes into the working-copy commit, local data included.
auto-track = "none()"

[revset-aliases]
# Other workspaces' empty working-copy commits (one per wt worktree) sitting
# right on a bookmark. Ones further ahead aren't idle and stay in the log.
"idle_working_copies()" = "(working_copies() ~ @) & empty() & children(bookmarks())"

[revsets]
# Hide idle_working_copies(); the commit under each shows it as name@- instead (see below).
log = "builtin_log() ~ idle_working_copies()"

[template-aliases]
# A commit's own workspaces as name@, plus name@- for each idle working copy on
# top of it. The labels stay next to their bookmark instead of floating to
# wherever the graph places the empty child, and each one is a revset that
# resolves to the commit it's on.
"format_commit_working_copies(commit)" = '''
separate(" ",
  commit.working_copies(),
  revset("children(" ++ commit.commit_id() ++ ") & idle_working_copies()")
    .map(|c| c.working_copies().map(|w| label("working_copies", w.name() ++ "@-"))),
)
'''

[remotes.origin]
# Track every bookmark fetched from origin, so they get local bookmarks and show in jj log.
auto-track-bookmarks = "*"

[aliases]
# The one-letter aliases from ~/.gitconfig, where jj has a counterpart (b is
# built in). None for reset, stash (no index or stash in jj), merge (jj
# new <a> <b>), pull (jj git fetch, then rebase) or init (jj repos here are set
# up by hand with a .jj-store; see ~/.config/worktrunk/jj-adopt). x is the
# git checkout <commit> sense: a new change on top; jj edit amends in place.
#
# i commits, advances one bookmark to it, and puts Git back on that branch,
# which jj leaves detached, so wt sees it. The bookmark is Git's branch, or
# after jj x the nearest one below; never several, since a new wt branch shares
# its commit with the one it came from. With none it just commits.
#
# Plan, to try on parser-combinator first: drop the workspace = branch mapping.
# i becomes plain commit, workspaces come from jj workspace add (no jj-adopt or
# worktrunk hooks), and bookmarks are only set for pushing (jj bookmark set
# <name> -r @- && jj git push -b <name>, or jj git push -c @-). Costs wt and
# Git's branch view in jj projects.
i = ["util", "exec", "--", "sh", "-c", 'b=$(git symbolic-ref -q --short HEAD || jj log -r "heads(::@ & bookmarks())" --no-graph -T "local_bookmarks.map(|b| b.name())"); case $b in *" "*) echo "jj i: several bookmarks ($b); jj commit, then jj bookmark advance --to @- <name>" >&2; exit 1;; esac; jj commit "$@" && { [ -z "$b" ] || { jj bookmark advance --to @- "exact:$b" && git switch -q "$b"; }; }', "jj-i"]
up = ["git", "fetch", "--all-remotes"]
c = ["git", "clone"]
d = ["diff"]
f = ["git", "fetch"]
sh = ["show"]
l = ["log"]
o = ["git", "remote"]
p = ["git", "push"]
r = ["rebase"]
# Short status like `git status -s`: changed files, then untracked ones (`? path`) pulled out of `jj status`.
s = ["util", "exec", "--", "sh", "-c", 'c=never; [ -t 1 ] && c=always; jj diff --summary --no-pager --color=$c "$@" && jj status --no-pager --color=$c "$@" | awk "/^Untracked paths:/ {u=1; next} /^[A-Z]/ {u=0} u"', "jj-s"]
t = ["tag"]
x = ["new"]
w = ["log", "--summary"]
cp = ["duplicate"]
# With auto-track off, new files need an explicit track, like git add.
add = ["file", "track"]

[colors]
"diff added" = "green"
"diff removed" = "red"
"diff modified" = "yellow"
"diff renamed" = "yellow"
"diff untracked" = "red"
