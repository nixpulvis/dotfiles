[general]
{{- $home := .chezmoi.homeDir | replace "\\" "/" }}
import = [
    "{{ $home }}/.config/alacritty/bindings.toml",
    # A link to nixpulvis-dark.toml or nixpulvis-light.toml. On macOS,
    # alacritty-color-mode keeps it in step with the system appearance.
    "{{ $home }}/.config/alacritty/colors.toml"
]
{{- if eq .chezmoi.os "windows" }}
working_directory = {{ .chezmoi.homeDir | quote }}
{{- end }}

{{- /* Without fish, macOS and Linux leave out the program, so Alacritty starts
       the login shell. */}}
{{- $fish := (includeTemplate "features" . | fromJson).fish }}
{{- if eq .chezmoi.os "windows" }}

[terminal.shell]
program = "C:\\Program Files\\Git\\bin\\bash.exe"
args = ["--login", "-i"]
{{- else if and $fish (eq .chezmoi.os "darwin") }}

[terminal.shell]
program = {{ if eq .chezmoi.arch "arm64" }}"/opt/homebrew/bin/fish"{{ else }}"/usr/local/bin/fish"{{ end }}
{{- else if $fish }}

[terminal.shell]
program = "/usr/bin/fish"
{{- end }}

[env]
WINIT_X11_SCALE_FACTOR = "1"

[font]
size = 14

[font.normal]
family = "Fira Mono"

[scrolling]
history = 10000
multiplier = 3

[window]
decorations = "full"
dynamic_padding = true
{{- if eq .chezmoi.os "darwin" }}
option_as_alt = "OnlyLeft"
{{- end }}
# padding = { x = 20, y = 20 }

[[keyboard.bindings]]
key = "Return"
mods = "Shift"
chars = "\u001B\r"
