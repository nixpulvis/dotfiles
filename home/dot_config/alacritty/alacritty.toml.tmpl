[general]
{{- $home := .chezmoi.homeDir | replace "\\" "/" }}
import = [
    "{{ $home }}/.config/alacritty/bindings.toml",
    "{{ $home }}/.config/alacritty/colors.toml"
]
{{ if ne .chezmoi.os "windows" }}
[terminal.shell]
{{- if eq .chezmoi.os "darwin" }}
program = {{ if eq .chezmoi.arch "arm64" }}"/opt/homebrew/bin/fish"{{ else }}"/usr/local/bin/fish"{{ end }}
{{- else }}
program = "/usr/bin/fish"
{{- end }}
{{ end }}

[env]
WINIT_X11_SCALE_FACTOR = "1"

[font]
size = 13

[font.normal]
family = "Fira Mono"

[scrolling]
history = 10000
multiplier = 3

[window]
decorations = "full"
dynamic_padding = true
# padding = { x = 20, y = 20 }

[[keyboard.bindings]]
key = "Return"
mods = "Shift"
chars = "\u001B\r"
