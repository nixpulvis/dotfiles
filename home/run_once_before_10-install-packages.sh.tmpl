{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Install packages for the selected component groups.
# Runs once per machine (re-runs only if this script's contents change).
set -eu

{{ if eq .chezmoi.os "darwin" -}}
# ---- macOS (Homebrew) ------------------------------------------------------
if ! command -v brew >/dev/null 2>&1; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
    if [ -x /usr/local/bin/brew ]; then eval "$(/usr/local/bin/brew shellenv)"; fi
fi

# base
brew install fish neovim ripgrep git jq fzf borgbackup pass fortune
{{ if .gui -}}
# gui
brew install --cask alacritty
brew install --cask font-fira-mono font-fira-sans
{{ end -}}

{{ else if eq .chezmoi.os "linux" -}}
# ---- Linux -----------------------------------------------------------------
{{ if lookPath "pacman" -}}
# Arch (pacman)
sudo pacman -S --needed --noconfirm \
    fish neovim ripgrep git jq fzf borg pass fortune-mod
{{ if .desktop -}}
sudo pacman -S --needed --noconfirm \
    sway i3-wm i3blocks dmenu rofi feh swaybg swayidle grim slurp \
    zathura zathura-pdf-poppler brightnessctl \
    ttf-fira-mono ttf-fira-sans
{{ else if .gui -}}
sudo pacman -S --needed --noconfirm alacritty ttf-fira-mono ttf-fira-sans
{{ end -}}
{{ else if lookPath "apt-get" -}}
# Debian / Ubuntu (apt)
sudo apt-get update
sudo apt-get install -y \
    fish neovim ripgrep git jq fzf borgbackup pass fortune-mod
{{ if .desktop -}}
sudo apt-get install -y \
    sway i3 i3blocks rofi feh grim slurp \
    zathura zathura-pdf-poppler brightnessctl fonts-firacode
{{ else if .gui -}}
sudo apt-get install -y alacritty fonts-firacode
{{ end -}}
{{ else -}}
echo "No supported package manager (pacman/apt) found; install packages manually." >&2
{{ end -}}
{{ end -}}
{{ end -}}
