{{- if and .libera (ne .chezmoi.os "windows") -}}
#!/bin/sh
# Generate a random passphrase for WeeChat's secured data (sec.conf) and store it
# in the OS keyring. modify_private_sec.conf.tmpl sets sec.crypt.passphrase_command
# to read it back, so WeeChat never asks for a password on launch. This runs once
# per machine, before files are applied. The passphrase only ever lives in the
# keyring (macOS login keychain or Linux Secret Service), never in this repo.
#
# The ZNC password is separate. Enter it once inside WeeChat with
# `/secure set znc <password>` and it gets encrypted into sec.conf with this
# passphrase. The post-install note and irc.conf's header explain the steps.
set -eu

service=weechat
account={{ .ircnick | quote }}

# Keep an existing passphrase. A new one would make anything already stored in
# sec.conf impossible to decrypt.
if v=$(chezmoi secret keyring get --service "$service" --user "$account" 2>/dev/null) \
   && [ -n "$v" ]; then
    exit 0
fi

# Generate a strong random passphrase (openssl if present, else /dev/urandom).
if ! pass=$(openssl rand -base64 32 2>/dev/null) || [ -z "$pass" ]; then
    pass=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64)
fi
pass=$(printf '%s' "$pass" | tr -d '\n')

if ! err=$(chezmoi secret keyring set --service "$service" --user "$account" --value "$pass" 2>&1); then
    echo "NOTE: Skipping WeeChat passphrase storage -- OS keyring unavailable." >&2
    echo "      (${err})" >&2
    echo "      Install/enable a Secret Service provider, then re-run:" >&2
    echo "        chezmoi state delete-bucket --bucket=scriptState && chezmoi apply" >&2
    exit 0
fi

echo "NOTE: WeeChat secured-data passphrase generated and stored in the OS keyring." >&2
echo "      Store your ZNC password once (see the reminder after package install)." >&2
{{- end -}}
