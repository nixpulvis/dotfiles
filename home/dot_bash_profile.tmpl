# PATH, Homebrew and editor, shared with zsh. Loaded here too so the window
# manager started below inherits them.
[[ -f ~/.config/sh/env.sh ]] && . ~/.config/sh/env.sh
{{ if (includeTemplate "features" . | fromJson).wm }}
# TODO: https://github.com/zed-industries/zed/issues/32792
export WLR_RENDER_NO_EXPLICIT_SYNC=1

# Set the terminal variable helps i3 decide what to do.
if command -v alacritty >/dev/null 2>&1; then
    export TERMINAL=alacritty
fi

# Start a window manager if we should.
if [[ $USER != "root" ]]; then
    if [[ ! $DISPLAY && $XDG_VTNR -eq 1 ]]; then
        export XDG_SESSION_TYPE=wayland
        exec sway &> $HOME/.sway_output
    elif [[ ! $DISPLAY && $XDG_VTNR -eq 2 ]]; then
        export XDG_SESSION_TYPE=x11
        exec startx &> $HOME/.Xoutput
    fi
fi
{{ end }}
[[ -f ~/.bashrc ]] && . ~/.bashrc
