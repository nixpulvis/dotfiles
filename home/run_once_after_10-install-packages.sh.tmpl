{{- $f := includeTemplate "features" . | fromJson -}}
{{- if and (ne .chezmoi.os "windows") (or .installPackages $f.weechat) -}}
#!/bin/sh
# Install the packages of this machine's enabled features, unless it opted out
# (installPackages). The packages are listed in .chezmoidata/features.yaml, so
# edit that instead of this script. `chezmoi` runs this once per machine, and
# again whenever the rendered script changes.
set -eu

{{ if not .installPackages -}}
{{ else if eq .chezmoi.os "darwin" -}}
# ---- macOS (Homebrew) ------------------------------------------------------
if ! command -v brew >/dev/null 2>&1; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
    if [ -x /usr/local/bin/brew ]; then eval "$(/usr/local/bin/brew shellenv)"; fi
fi
{{ $formulae := includeTemplate "packages" (dict "manager" "brew" "data" .) | fromJson -}}
{{ $casks := includeTemplate "packages" (dict "manager" "brew_cask" "data" .) | fromJson -}}
{{ if $formulae }}brew install {{ $formulae | join " " }}
{{ end -}}
{{ if $casks }}brew install --cask --adopt {{ $casks | join " " }}
{{ end -}}
{{ if $f.alacritty -}}
# There's no Alacritty package to install here because the Homebrew cask is
# deprecated. Print a reminder if it isn't already installed.
if ! command -v alacritty >/dev/null 2>&1 && [ ! -d /Applications/Alacritty.app ]; then
    echo "NOTE: Alacritty is not installed. Its Homebrew cask is deprecated on macOS;" >&2
    echo "      install manually: https://github.com/alacritty/alacritty/releases" >&2
fi
{{ end -}}

{{ else if eq .chezmoi.os "linux" -}}
# ---- Linux -----------------------------------------------------------------
{{ if lookPath "pacman" -}}
{{ $pkgs := includeTemplate "packages" (dict "manager" "pacman" "data" .) | fromJson -}}
echo "sudo: installing system packages via pacman (root required to write to /usr and /var)." >&2
sudo pacman -S --needed --noconfirm {{ $pkgs | join " " }}
{{ else if lookPath "apt-get" -}}
{{ $pkgs := includeTemplate "packages" (dict "manager" "apt" "data" .) | fromJson -}}
echo "sudo: refreshing apt package index (root required for /var/lib/apt)." >&2
sudo apt-get update
echo "sudo: installing system packages via apt (root required to write to /usr and /var)." >&2
sudo apt-get install -y {{ $pkgs | join " " }}
{{ else -}}
echo "No supported package manager (pacman/apt) found; install packages manually." >&2
{{ end -}}
{{ end -}}
{{ if and .installPackages $f.rust -}}
# ---- Rust ------------------------------------------------------------------
# rustup comes from the packages above. A fresh one has no toolchain, so install
# stable, then the components Neovim's rust_analyzer and RUST_SRC_PATH need;
# from rustup, they match the toolchain.
{{ if eq .chezmoi.os "darwin" -}}
# Homebrew's rustup is keg-only.
for d in /opt/homebrew/opt/rustup/bin /usr/local/opt/rustup/bin; do
    if [ -d "$d" ]; then PATH="$d:$PATH"; fi
done
{{ end -}}
if command -v rustup >/dev/null 2>&1; then
    rustup which rustc >/dev/null 2>&1 || rustup default stable
    rustup component add rust-analyzer rust-src
else
    echo "NOTE: rustup isn't installed; skipping the Rust toolchain." >&2
fi
{{ end -}}

{{- if $f.weechat }}
# ---- WeeChat: ZNC bouncer login --------------------------------------------
# `chezmoi` sets up the connection and channels, and WeeChat reads its secured
# data passphrase from the keyring, so there's no prompt on launch. The ZNC
# password still has to be stored once by hand with `/secure set`. Only remind
# when sec.conf has no `znc` entry yet; this script reruns whenever it changes.
if ! grep -q '^znc = ' "$HOME/.config/weechat/sec.conf" 2>/dev/null; then
cat >&2 <<'EOF'

NOTE: WeeChat is set up for your ZNC bouncer (ref8.net) as "{{ .ircnick }}",
      autojoining: {{ .weechat.autojoin | join ", " }}. It reads its secured-data
      passphrase from the OS keyring automatically -- no prompt on launch. Store
      your ZNC password ONCE (the first encrypted entry needs the passphrase in
      the environment; after that plain `weechat` just works):
        env WEECHAT_PASSPHRASE="$(chezmoi secret keyring get --service weechat --user {{ .ircnick }})" weechat
      then, inside WeeChat:
        /secure set znc <ZNC password>
        /save
      The password option is already ${sec.data.znc}. Verify: /msg *status ListNetworks
EOF
fi
{{- end }}
{{ end -}}
