{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Install packages for the active component groups. Package names come from
# .chezmoidata/packages.yaml (single source of truth) — edit that, not this.
# Runs once per machine (re-runs if the rendered command changes).
set -eu

{{- $groups := list "base" -}}
{{- if .graphical }}{{ $groups = append $groups "graphical" }}{{ end -}}
{{- if .wm }}{{ $groups = append $groups "wm" }}{{ end }}

{{ if eq .chezmoi.os "darwin" -}}
# ---- macOS (Homebrew) ------------------------------------------------------
if ! command -v brew >/dev/null 2>&1; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
    if [ -x /usr/local/bin/brew ]; then eval "$(/usr/local/bin/brew shellenv)"; fi
fi
{{ $formulae := list -}}
{{ $casks := list -}}
{{- range $g := $groups }}{{ range $p := index $.packages $g -}}
{{- if hasKey $p "brew" }}{{ $formulae = append $formulae $p.brew }}{{ end -}}
{{- if hasKey $p "brew_cask" }}{{ $casks = append $casks $p.brew_cask }}{{ end -}}
{{- end }}{{ end -}}
{{ if $formulae }}brew install {{ $formulae | join " " }}
{{ end -}}
{{ if $casks }}brew install --cask --adopt {{ $casks | join " " }}
{{ end -}}
{{ if .graphical -}}
# Alacritty has no macOS package here (the Homebrew cask is deprecated and being
# disabled). Remind the user to install it by hand if it isn't already present.
if ! command -v alacritty >/dev/null 2>&1 && [ ! -d /Applications/Alacritty.app ]; then
    echo "NOTE: Alacritty is not installed. Its Homebrew cask is deprecated on macOS;" >&2
    echo "      install manually: https://github.com/alacritty/alacritty/releases" >&2
fi
{{ end -}}

{{ else if eq .chezmoi.os "linux" -}}
# ---- Linux -----------------------------------------------------------------
{{ if lookPath "pacman" -}}
{{ $pkgs := list -}}
{{- range $g := $groups }}{{ range $p := index $.packages $g -}}
{{- if hasKey $p "pacman" }}{{ $pkgs = append $pkgs $p.pacman }}{{ end -}}
{{- end }}{{ end -}}
sudo pacman -S --needed --noconfirm {{ $pkgs | join " " }}
{{ else if lookPath "apt-get" -}}
{{ $pkgs := list -}}
{{- range $g := $groups }}{{ range $p := index $.packages $g -}}
{{- if hasKey $p "apt" }}{{ $pkgs = append $pkgs $p.apt }}{{ end -}}
{{- end }}{{ end -}}
sudo apt-get update
sudo apt-get install -y {{ $pkgs | join " " }}
{{ else -}}
echo "No supported package manager (pacman/apt) found; install packages manually." >&2
{{ end -}}
{{ end -}}

{{- if .libera }}
# ---- WeeChat: ZNC bouncer login --------------------------------------------
# chezmoi configures the connection + channels and points WeeChat's secured data
# at a keyring-stored passphrase (no prompt on launch). You store the ZNC
# password once, encrypted, with `/secure set`.
cat >&2 <<'EOF'

NOTE: WeeChat is set up for your ZNC bouncer (ref8.net) as "{{ .ircnick }}",
      autojoining: {{ .weechat.autojoin | join ", " }}. It reads its secured-data
      passphrase from the OS keyring automatically -- no prompt on launch. Store
      your ZNC password ONCE (the first encrypted entry needs the passphrase in
      the environment; after that plain `weechat` just works):
        env WEECHAT_PASSPHRASE="$(chezmoi secret keyring get --service weechat --user {{ .ircnick }})" weechat
      then, inside WeeChat:
        /secure set znc <ZNC password>
        /save
      The password option is already ${sec.data.znc}. Verify: /msg *status ListNetworks
EOF
{{- end }}
{{ end -}}
