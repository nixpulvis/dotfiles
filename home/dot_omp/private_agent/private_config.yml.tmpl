{{ if eq .chezmoi.os "windows" -}}
shellPath: C:\Program Files\Git\bin\bash.exe
{{ end -}}
setupVersion: 2
modelRoles:
  commit: anthropic/claude-haiku-5-5
  default: anthropic/claude-opus-5-5:high
symbolPreset: ascii
composer:
  # Custom shape from extensions/composer-rules.ts: prompt between two rules,
  # status bar directly below, no gutter/padding/fill.
  shape: nate.rules
theme:
  dark: titanium-me
  light: light
steeringMode: one-at-a-time
followUpMode: one-at-a-time
interruptMode: immediate
doubleEscapeAction: rewind
emojiAutocomplete: false
paste:
  largeMenuThreshold: 0
error:
  notify: "on"
proseOnlyThinking: true
hideThinkingBlock: true
statusLine:
  preset: custom
  sessionAccent: false
  separator: block
  # Default preset's segments minus the leading `pi` logo, with model and
  # context moved to the right, plus a `usage` segment that shows the Claude
  # subscription rate-limit windows: 5h (rolling session) and 7d (weekly),
  # each as "<pct>% (<reset>)". The theme blanks the `ctx:`/`t:` labels.
  #
  # `status` shows the session name, length-capped by
  # extensions/session-title.ts (built-in `session_name` has no cap).
  # showHookStatus: false stops it repeating as a line below the bar.
  showHookStatus: false
  leftSegments:
    - mode
    - collab
    - path
    - git
    - pr
    - status
  rightSegments:
    - model
    - context_pct
    - usage
  segmentOptions:
    model:
      showThinkingLevel: true
    path:
      abbreviate: true
      maxLength: 40
      stripWorkPrefix: true
    git:
      showBranch: true
      showStaged: true
      showUnstaged: true
      showUntracked: true
tui:
  tight: true
  # Commit transcript rows to scrollback when a growing HUD/dialog pushes them
  # off screen; otherwise they are dropped, which cut the bottom off framed
  # cards (e.g. the todo box lost its last phase row and bottom border).
  completeScrollback: true
display:
  shimmer: kitt
  showTokenUsage: true
defaultThinkingLevel: auto
dev:
  autoqaConsent: denied
startup:
  changelogMode: hidden
  # Hides the welcome block (logo, version, Tip) and startup status messages;
  # omp has no tip-only toggle.
  quiet: true