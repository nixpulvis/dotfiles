{{- if eq .chezmoi.os "windows" -}}
{{-   $current := include ".chezmoi.toml.tmpl" | sha256sum -}}
{{-   $stored := "" -}}
{{-   if hasKey . "configTemplateHash" }}{{ $stored = .configTemplateHash }}{{ end -}}
{{-   if ne $stored $current -}}
# A louder version of `chezmoi`'s easy-to-miss "config file template has
# changed" warning. The template guard above compares the config template's
# hash from the last `chezmoi init` (.configTemplateHash, missing counts as
# drift) with its current hash. If they match, this renders empty and is
# skipped. On drift it prints the banner, then aborts `chezmoi update`, since
# updating with stale config is wrong. (`chezmoi update --init` regenerates
# config first, so it never gets here.) For `apply` it only warns. Older
# `chezmoi` without CHEZMOI_COMMAND only gets the warning.
Write-Warning ''
Write-Warning '########################################################################'
Write-Warning '#  chezmoi: CONFIG FILE TEMPLATE HAS CHANGED -- your config is STALE.   #'
Write-Warning '#                                                                      #'
Write-Warning '#  Regenerate it (reuses your saved answers, won''t re-prompt):          #'
Write-Warning '#                                                                      #'
Write-Warning '#      chezmoi update --init      # pull + regenerate config + apply    #'
Write-Warning '#      chezmoi init               # regenerate config only             #'
Write-Warning '#                                                                      #'
Write-Warning '#  Until then, dotfiles are applied from OUTDATED config values.       #'
Write-Warning '########################################################################'
Write-Warning ''
if ($env:CHEZMOI_COMMAND -eq 'update') {
    Write-Warning 'Refusing to update with a stale config. Run: chezmoi update --init'
    Write-Warning ''
    exit 1
}
{{-   end -}}
{{- end -}}
